{
  "benchmark": "ns2d",
  "description": "2D Navier-Stokes compresible (estado en t=0.5). Entrada: rho0 (64x64) + (gamma, mu). Salida: rho (64x64).",
  "data": {
    "append_params": true,
    "splits": {
      "train": {
        "generator": "ns2d",
        "n": 10000,
        "seed": 3000000,
        "jacobian": false
      },
      "val": {
        "generator": "ns2d",
        "n": 500,
        "seed": 2000000,
        "jacobian": false
      },
      "test": {
        "generator": "ns2d",
        "n": 500,
        "seed": 1000000,
        "jacobian": true
      }
    },
    "generator_args": {
      "nx": 64,
      "T": 0.5,
      "batch_size": 20
    }
  },
  "model": {
    "branch": [
      4098,
      256,
      256,
      256,
      256,
      256,
      256,
      256,
      256,
      256,
      256
    ],
    "trunk": [
      2,
      256,
      256,
      256,
      256,
      256,
      256,
      256,
      256,
      256,
      256
    ],
    "activation": "swish",
    "sigma": {
      "jacobian": 0.05,
      "vanilla": 0.025
    }
  },
  "train": {
    "optimizer": "adam",
    "iterations": 200000,
    "display_every": 1000,
    "val_every": 5000,
    "val_infer_batch": 50,
    "unc_ref_subset": 1024,
    "selection_metric": "interval_score",
    "patience": null,
    "min_select_step": 0,
    "batch_size": 128,
    "learning_rate": 0.001,
    "decay_rate": 0.7,
    "decay_steps": 50000
  },
  "sweep": {
    "models": [
      "jacobian"
    ],
    "lambdas": [
      4
    ],
    "seeds": [
      0,
      1,
      2
    ],
    "note": "Piloto: solo Jacobian con lambda=4 (decision del 2026-09-21). Ampliar aqui para el barrido completo."
  },
  "source": "scripts/ns2d/ns2d_lambda_sweep.sh, ns2d_vanilla_pinball_sweep.sh"
}
