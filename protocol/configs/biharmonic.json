{
  "benchmark": "biharmonic",
  "description": "2D biarmonica (fair-sciml). Entrada: f = c*g en 4225 nodos. Salida: u en 4225 nodos.",
  "data": {
    "append_params": false,
    "splits": {
      "train": {
        "file": "data/biharmonic_equation.h5",
        "n": 3010
      },
      "val": {
        "generator": "biharmonic_scaled",
        "n": 500,
        "seed": 20260922
      },
      "test": {
        "generator": "biharmonic_scaled",
        "n": 3010,
        "seed": 20260921
      }
    },
    "generator_args": {
      "c_min": 1.0,
      "c_max": 5.0
    },
    "notes": "El train no se puede regenerar (solver FEM de fair-sciml). Val y test son exactos por linealidad. Todo el dataset es una familia de un parametro (g fija): mide interpolacion en c."
  },
  "model": {
    "branch": [
      4225,
      256,
      256,
      256,
      256,
      256,
      256,
      256,
      256,
      256,
      256
    ],
    "trunk": [
      2,
      256,
      256,
      256,
      256,
      256,
      256,
      256,
      256,
      256,
      256
    ],
    "activation": "swish",
    "sigma": {
      "jacobian": 0.025,
      "vanilla": 0.025
    }
  },
  "train": {
    "optimizer": "adam",
    "iterations": 200000,
    "display_every": 1000,
    "val_every": 5000,
    "val_infer_batch": 50,
    "unc_ref_subset": 1024,
    "selection_metric": "interval_score",
    "patience": null,
    "min_select_step": 0,
    "batch_size": 512,
    "learning_rate": 0.0001,
    "decay_rate": 0.8,
    "decay_steps": 50000
  },
  "sweep": {
    "models": [
      "jacobian"
    ],
    "lambdas": [
      4
    ],
    "seeds": [
      0,
      1,
      2
    ],
    "note": "Piloto: solo Jacobian con lambda=4, en A100 (decision del 2026-09-21). Ampliar aqui para el barrido completo."
  },
  "source": "scripts/biharmonic/bh_lambda_sweep.sh, bh_vanilla_pinball_sweep.sh (lambdas del paper: 1,4,8,20)"
}
