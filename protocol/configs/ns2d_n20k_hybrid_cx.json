{
  "benchmark": "ns2d_n20k_hybrid_cx",
  "description": "EXPERIMENTO (NS2D, 20000): hibrido jacobiano + correccion centrada solo espacial (~200 params): repite el experimento que quedo degenerado.",
  "data_from": "ns2d_n20k",
  "model": {
    "branch": [
      1026,
      100,
      100,
      100,
      100,
      100
    ],
    "trunk": [
      2,
      100,
      100,
      100,
      100,
      100
    ],
    "activation": "swish",
    "sigma": {
      "jacobian": 0.05,
      "vanilla": 0.025,
      "jacobian_quantile": 0.05,
      "jacobian_quantile_cx": 0.05
    }
  },
  "train": {
    "optimizer": "adam",
    "iterations": 200000,
    "display_every": 1000,
    "val_every": 5000,
    "val_infer_batch": 50,
    "unc_ref_subset": 1024,
    "selection_metric": "interval_score",
    "patience": 8,
    "min_select_step": 0,
    "batch_size": 128,
    "learning_rate": 0.001,
    "decay_rate": 0.7,
    "decay_steps": 50000
  },
  "sweep": {
    "models": [
      "jacobian_quantile_cx"
    ],
    "lambdas": [
      4
    ],
    "seeds": [
      0
    ],
    "note": "La escala global queda solo en softplus(w); la cabeza solo codifica variacion."
  },
  "source": "Derivada de ns2d_n20k.json; solo cambia el barrido de modelos.",
  "input_transform": {
    "type": "grid_stride",
    "grid": [
      64,
      64
    ],
    "stride": 2
  }
}
